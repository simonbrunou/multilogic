{
	"name": "multilogic",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "bun@1.4.4",
	"engines": {
		"bun": ">=1.1.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker && tsc -p tsconfig.scripts.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:unit": "vitest run --project unit",
		"test:browser": "vitest run --project browser",
		"test:coverage": "vitest run --project unit --coverage",
		"test:watch": "vitest",
		"check:engine": "tsc -p tsconfig.engine.json",
		"lint": "eslint .",
		"pregen": "bun run scripts/pregen.ts",
		"serve": "bun serve.js",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.6",
		"@vitest/browser": "^5.1.0",
		"@vitest/browser-playwright": "^5.1.0",
		"@vitest/coverage-v8": "^5.1.0",
		"eslint": "^10.15.0",
		"fallow": "^3.42.0",
		"fast-check": "^4.10.2",
		"playwright": "^1.65.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0",
		"vitest-browser-svelte": "^3.1.0",
		"yaml": "^2.9.1"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
